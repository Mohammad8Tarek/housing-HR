{
  "mcpServers": {
    "postgres": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:admin123@localhost:5432/staff-housing"
      ],
      "env": {
        "PGDATABASE": "staff-housing"
      }
    },
    "puppeteer": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    }
  }
}
