{
  "sunrise-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-tool-safety-hook.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
